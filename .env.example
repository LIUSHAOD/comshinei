# MySQL / Redis
DATABASE_URL=mysql+pymysql://root:root@127.0.0.1:3306/comshinei?charset=utf8mb4
REDIS_URL=redis://127.0.0.1:6379/0

# Qdrant
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=interior_styles

# ComfyUI（裸机运行，不进 Docker）
COMFYUI_HOST=127.0.0.1:8188
COMFYUI_TIMEOUT=300

# LLM（OpenAI 兼容）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxx
LLM_MODEL=deepseek-chat

# Langfuse
LANGFUSE_HOST=http://127.0.0.1:3000
LANGFUSE_PUBLIC_KEY=pk-xxx
LANGFUSE_SECRET_KEY=sk-xxx

# 存储
UPLOAD_DIR=./data/uploads
OUTPUT_DIR=./data/outputs
IMAGE_TTL_DAYS=30

# CLIP 向量检索（M3+）
CLIP_MODEL_NAME=sentence-transformers/clip-ViT-B-32
SEARCH_CANDIDATE_LIMIT=8
# huggingface.co 不可达时取消注释（国内网络）
HF_ENDPOINT=https://hf-mirror.com
