# 部署环境变量（cp deploy/.env.example deploy/.env 后按实填写）
# compose 内部网络：基础设施用服务名互访；ComfyUI 裸机经 host.docker.internal 连接

DATABASE_URL=mysql+pymysql://root:root@mysql:3306/comshinei?charset=utf8mb4
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=interior_styles

COMFYUI_HOST=http://host.docker.internal:8188
COMFYUI_TIMEOUT=300

LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxx
LLM_MODEL=deepseek-chat

LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

CLIP_MODEL_NAME=sentence-transformers/clip-ViT-B-32
SEARCH_CANDIDATE_LIMIT=8
HF_ENDPOINT=https://hf-mirror.com

UPLOAD_DIR=./data/uploads
OUTPUT_DIR=./data/outputs
IMAGE_TTL_DAYS=30
CLEANUP_INTERVAL_HOURS=24
